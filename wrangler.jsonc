{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-hub",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-hub",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "study-hub-uploads"
    }
  ],
  "vars": {
    "INITIAL_OWNER_USERNAME": "heng",
    "INITIAL_OWNER_NAME": "Heng"
  }
}
